# ============================================================
# MORPHOGEN CONFIGURATION
# ============================================================

# Copy this file to .env and configure your settings

# ============================================================
# LLM CONFIGURATION
# ============================================================

# Option 1: Ollama (Local, Free)
# Download from: https://ollama.ai
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: Anthropic Claude (Cloud, Paid)
# Get API key from: https://console.anthropic.com
USE_CLAUDE=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: Google Gemini (Cloud, Paid)
# Get API key from: https://makersuite.google.com/app/apikey
USE_GEMINI=false
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# EXPORT CONFIGURATION
# ============================================================

# IFC (BIM) Settings
IFC_SCHEMA=IFC4
IFC_ORGANIZATION=Your Company Name

# DXF (CAD) Settings
DXF_VERSION=R2018

# ============================================================
# VALIDATION CONFIGURATION
# ============================================================

# Enable/disable strict validation
ENABLE_STRICT_VALIDATION=true

# Industrial Validation Parameters
MIN_EQUIPMENT_CLEARANCE=1.5    # meters
MIN_PIPE_SPACING=0.5           # meters
MAX_PIPE_LENGTH=6.0            # meters
MAX_LIQUID_VELOCITY=3.0        # m/s

# Building Validation Parameters
MIN_WALL_THICKNESS=100         # mm
MIN_ROOM_AREA=4.0              # square meters

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS settings (for web frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
LOG_FILE=morphogen.log

# ============================================================
# NOTES
# ============================================================

# 1. Choose only ONE LLM option (Ollama, Claude, or Gemini)
# 2. For Ollama: Make sure it's running (ollama serve)
# 3. For cloud LLMs: Add your API keys
# 4. Adjust validation parameters based on your requirements
# 5. Enable DEBUG for development, disable for production
